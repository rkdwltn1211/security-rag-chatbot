# =================================================================
# 🔐 기업 IT 보안 정책 AI 어시스턴트 - 환경 변수 설정 양식 (.env.example)
# =================================================================
# ⚠️ 주의: 이 파일에는 실제 비밀번호나 API 키를 적지 마세요!
# 💡 다른 사용자는 이 파일을 복사하여 '.env' 파일을 만든 후 실제 값을 입력해야 합니다.

# 1. OpenAI API 설정
OPENAI_API_KEY=your_openai_api_key_here

# 2. PostgreSQL 데이터베이스 설정
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_database_password_here
DB_NAME=security_rag_db

# 3. JWT 인증 설정 (보안 토큰용 무작위 문자열)
SECRET_KEY=your_jwt_secret_key_here

# 로컬 개발 전용. 운영 변수는 .env.production.example 참고.
APP_ENV=development
# 쉼표로 구분. production은 HTTPS origin을 명시해야 하며 * 금지.
CORS_ORIGINS=http://localhost:5173,http://localhost,http://localhost:80
# Docker frontend 빌드용. 운영에서는 공개 HTTPS 백엔드 주소 지정.
VITE_API_URL=http://localhost:8001
DB_SSLMODE=prefer
CHROMA_DIR=vectorstore
CHROMA_RESTORE_FROM_DB=false
