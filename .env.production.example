# Reference only: set these in the BACKEND hosting service's secret settings.
# Production never automatically loads local .env files. Do not commit real values.
APP_ENV=production
SECRET_KEY=
OPENAI_API_KEY=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require
CORS_ORIGINS=https://your-frontend.pages.dev
CHROMA_DIR=/tmp/security-rag-chroma
CHROMA_RESTORE_FROM_DB=true

# FRONTEND build setting only (public, never put secrets in VITE_*).
VITE_API_URL=https://your-backend.onrender.com
